# 5. 修改 Windows 流水线，确保把 VBS 打包cat << 'EOF' > .github/workflows/build.ymlname: Build Windows Setupon:  push:    tags: ['v*']  workflow_dispatch:permissions:  contents: writejobs:  build:    runs-on: windows-latest    steps:      - uses: actions/checkout@v4      - uses: actions/setup-node@v4        with: { node-version: '18' }      - run: npm install      - run: npm run build      - run: choco install innosetup -y      - run: iscc setup.iss      - name: Upload to GitHub Releases        uses: softprops/action-gh-release@v1        if: startsWith(github.ref, 'refs/tags/')        with:          files: dist/WHITE_ModLauncher_Setup.exeEOF# 6. 提交并推送git add .git commit -m "feat: complete full overwrite with silent vbs and game hijack"git push origin main




